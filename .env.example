# Copy to .env next to compose.yaml, then fill in the key. NEVER commit .env.
#
# The key that encrypts every authenticator secret in the database. Make one with:
#   docker run --rm python:3.12-slim sh -c "pip install -q cryptography && \
#     python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'"
# Keep it safe: lose it and everyone must set up their authenticator app again.
DIACAUSAL_SECRET_KEY=

# The address people will type. `localhost` uses Caddy's own certificate (a laptop demo);
# a real name like diacausal.example.org gets a free certificate automatically.
SITE_ADDRESS=localhost

# Ports on the host machine.
HTTP_PORT=8080
HTTPS_PORT=8443
