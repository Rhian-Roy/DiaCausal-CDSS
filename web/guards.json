 "regex": {
  "word": {
   "source": "(?:[\\p{L}\\p{N}]|[\\u0300-\\u036f\\u0900-\\u0903\\u093a-\\u094f\\u0951-\\u0957\\u0962\\u0963])+(?:'(?:[\\p{L}\\p{N}]|[\\u0900-\\u097f])+)*",
   "flags": "gu"
  },
  "identifiers": [
   {
    "source": "(?<!\\d)[2-9]\\d{3}[ -]?\\d{4}[ -]?\\d{4}(?!\\d)",
    "flags": "gu",
    "verhoeff": true
   },
   {
    "source": "(?<!\\d)\\d{2}-\\d{4}-\\d{4}-\\d{4}(?!\\d)",
    "flags": "gu",
    "verhoeff": false
   },
   {
    "source": "\\b[a-z0-9._]{3,}@(abdm|sbx)\\b",
    "flags": "giu",
    "verhoeff": false
   },
   {
    "source": "(?<![\\d+])(?:\\+?91[ -]?|0)?[6-9]\\d{4}[ -]?\\d{5}(?!\\d)",
    "flags": "gu",
    "verhoeff": false
   },
   {
    "source": "\\b[A-Z]{3}[PCHFATBLJG][A-Z]\\d{4}[A-Z]\\b",
    "flags": "gu",
    "verhoeff": false
   },
   {
    "source": "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}\\b",
    "flags": "gu",
    "verhoeff": false
   }
  ],
  "honorific_name": {
   "source": "\\b(?:[mM][rR]|[mM][rR][sS]|[mM][sS]|[mM][iI][sS][sS]|[dD][rR]|[pP][rR][oO][fF]|[sS][hH][rR][iI]|[sS][mM][tT]|[sS][rR][iI]|[kK][uU][mM][aA][rR][iI]|[mM][aA][sS][tT][eE][rR])\\b\\.?\\s+[A-Zऀ-ॿ]\\p{L}+",
