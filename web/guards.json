  },
  "glucose": {
   "source": "\\b(?:glucose|sugar|cbg|rbs|fbs|grbs|bg)\\b\\D{0,12}?(\\d{1,3}(?:\\.\\d)?)\\s*(mg/dl|mmol/l|mmol)?",
