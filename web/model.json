 "rules": [
  {
   "rule_id": "R01",
   "arm": "SGLT2i",
   "field": "egfr",
   "op": "lt",
   "value": 45.0,
   "action": "EXCLUDE",
   "message": "Not recommended to improve glycaemic control when eGFR < 45 mL/min/1.73 m2. KDIGO 2022 Rec 1.3.1 supports SGLT2i at eGFR >= 20 for kidney/heart protection - a different purpose; flag for the clinician.",
   "source": "FARXIGA (dapagliflozin) US prescribing information (DailyMed); KDIGO 2022 Diabetes in CKD",
   "section": "PI Sec 1 Limitations of Use, 2.2; KDIGO Rec 1.3.1",
   "status": "VERIFIED",
   "condition": "egfr < 45"
  },
  {
   "rule_id": "R02",
   "arm": "SGLT2i",
   "field": "t1d",
   "op": "eq",
   "value": 1.0,
   "action": "EXCLUDE",
   "message": "Not recommended for glycaemic control in type 1 diabetes.",
   "source": "FARXIGA US prescribing information (DailyMed)",
   "section": "Sec 1 Limitations of Use",
   "status": "VERIFIED",
   "condition": "t1d = 1"
  },
  {
   "rule_id": "R03",
   "arm": "SGLT2i",
   "field": "dka_history",
   "op": "eq",
   "value": 1.0,
   "action": "CAUTION",
   "message": "History of ketoacidosis: SGLT2 inhibitors carry a ketoacidosis warning; clinician review.",
   "source": "FARXIGA US prescribing information (DailyMed)",
   "section": "Sec 5.1 (to confirm)",
   "status": "UNVERIFIED",
   "condition": "dka_history = 1"
  },
  {
   "rule_id": "R04",
   "arm": "DPP4i",
   "field": "egfr",
   "op": "lt",
   "value": 45.0,
   "action": "CAUTION",
   "message": "Renal dose adjustment required per label when eGFR < 45 mL/min/1.73 m2. This system never displays doses - consult the label.",
   "source": "JANUVIA (sitagliptin) US prescribing information (DailyMed)",
   "section": "Sec 2.2",
   "status": "VERIFIED",
   "condition": "egfr < 45"
  },
  {
   "rule_id": "R05",
   "arm": "DPP4i",
   "field": "pancreatitis_history",
   "op": "eq",
   "value": 1.0,
   "action": "CAUTION",
   "message": "Not studied in patients with a history of pancreatitis; acute pancreatitis reported after marketing.",
   "source": "JANUVIA US prescribing information (DailyMed)",
   "section": "Sec 1; 5.1",
   "status": "VERIFIED",
   "condition": "pancreatitis_history = 1"
  },
  {
   "rule_id": "R06",
   "arm": "DPP4i",
   "field": "hf",
   "op": "eq",
   "value": 1.0,
   "action": "CAUTION",
   "message": "Heart failure observed with two other DPP-4 inhibitors (class-level); consider risks and benefits.",
   "source": "JANUVIA US prescribing information (DailyMed)",
   "section": "Sec 5.2",
   "status": "VERIFIED",
   "condition": "hf = 1"
  },
  {
   "rule_id": "R07",
   "arm": "SU",
   "field": "hypo_history",
   "op": "eq",
   "value": 1.0,
   "action": "CAUTION",
   "message": "Sulfonylureas can cause severe hypoglycaemia; prior hypoglycaemia increases concern.",
   "source": "Glimepiride US prescribing information (DailyMed)",
   "section": "Sec 5.1",
   "status": "VERIFIED",
   "condition": "hypo_history = 1"
  },
  {
   "rule_id": "R08",
   "arm": "SU",
   "field": "age",
   "op": "ge",
   "value": 65.0,
   "action": "CAUTION",
   "message": "Older patients are at higher hypoglycaemia risk; label advises a conservative start. Age cut-off 65 is team-set.",
   "source": "Glimepiride US prescribing information (DailyMed)",
   "section": "Sec 2.1; 8.5",
   "status": "UNVERIFIED",
   "condition": "age >= 65"
  },
  {
   "rule_id": "R09",
   "arm": "SU",
   "field": "egfr",
   "op": "lt",
   "value": 60.0,
   "action": "CAUTION",
   "message": "Kidney impairment increases hypoglycaemia risk; label advises a conservative start. eGFR cut-off 60 is team-set.",
   "source": "Glimepiride US prescribing information (DailyMed)",
   "section": "Sec 2.1; 8.6",
   "status": "UNVERIFIED",
   "condition": "egfr < 60"
  },
  {
   "rule_id": "R10",
   "arm": "SU",
   "field": "egfr",
   "op": "lt",
   "value": 30.0,
   "action": "EXCLUDE",
   "message": "Severe kidney impairment: team-set exclusion pending clinician and KDIGO confirmation.",
   "source": "Team rule pending review",
   "section": "TBD",
   "status": "UNVERIFIED",
   "condition": "egfr < 30"
  }
 ],
