# Copy to backend/.env (scripts/setup.py does this for you, with a fresh key).
# NEVER commit backend/.env.

# Fernet key that encrypts MFA secrets. Make one with:
#   .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DIACAUSAL_SECRET_KEY=

# Optional. Default: sqlite file backend/diacausal.db
# DIACAUSAL_DATABASE_URL=sqlite:////absolute/path/to/diacausal.db
