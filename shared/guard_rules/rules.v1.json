 "identifiers": {
  "aadhaar": {
   "regex": "(?<!\\d)[2-9]\\d{3}[ -]?\\d{4}[ -]?\\d{4}(?!\\d)",
   "extra_check": "verhoeff",
   "source": "UIDAI: 12-digit number, first digit not 0 or 1, last digit a Verhoeff check digit"
  },
  "abha_number": {
   "regex": "(?<!\\d)\\d{2}-\\d{4}-\\d{4}-\\d{4}(?!\\d)",
   "source": "ABDM: 14-digit ABHA number, shown as XX-XXXX-XXXX-XXXX"
  },
  "abha_address": {
   "regex": "\\b[a-z0-9._]{3,}@(abdm|sbx)\\b",
   "flags": "i"
  },
  "indian_mobile": {
   "regex": "(?<![\\d+])(?:\\+?91[ -]?|0)?[6-9]\\d{4}[ -]?\\d{5}(?!\\d)",
   "source": "TRAI numbering: 10-digit mobile numbers start with 6, 7, 8 or 9",
   "known_false_positive": "Any stand-alone 10-digit number starting 6-9 (e.g. a lab accession) is treated as a phone number. Accepted: blocking is safe, the user just removes it."
  },
  "pan": {
   "regex": "\\b[A-Z]{3}[PCHFATBLJG][A-Z]\\d{4}[A-Z]\\b",
   "source": "Income Tax Dept: PAN = 5 letters (4th = holder type) + 4 digits + 1 letter; match on original case"
  },
  "email": {
   "regex": "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}\\b"
  }
 },
